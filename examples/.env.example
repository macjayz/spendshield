# Copy to examples/.env (never commit it).

# RPC to use. Aevum testnet by default; http://127.0.0.1:8555 for `make fork`, http://127.0.0.1:8545 for `make anvil`.
RPC_URL=https://rpc-test.qday.info

# Address of your deployed Checkout (printed by `make deploy-aevum`, `make deploy-fork` or `make deploy-local`).
CHECKOUT_ADDRESS=

# pay-gasless only. Use throwaway TEST wallets, never a wallet that holds real funds.
# BUYER_KEY signs (needs tUSD8, no gas). RELAYER_KEY submits (needs a little tQDAY).
BUYER_KEY=
RELAYER_KEY=

# check-setup: the address to inspect. read-payments: if set, only payments from this address.
ADDRESS=

# ---- SpendShield agent (pnpm example agent) ----
# Your deployed SpendShield (printed by `make deploy-shield-*`).
SHIELD_ADDRESS=
# The human whose vault the agent spends from (your main test wallet address, NOT its key).
OWNER_ADDRESS=
# The agent's own key. A fresh throwaway key: it holds no money, it only signs.
AGENT_KEY=
# Optional. If set, this wallet submits the agent's signed payments and pays the gas (gasless agent).
# RELAYER_KEY above is reused if you set it.
# Where the pay-per-call API lives (the web app's /api/paid route).
MERCHANT_API=http://localhost:3000/api/paid
# Optional. Comma-separated resources to buy: market-data, weather, premium-report.
# TASKS=market-data,weather,market-data,premium-report
# Optional. 1 = after asking the owner for approval, wait (up to 10 min) and finish the purchase.
# WAIT_FOR_APPROVAL=1

# ---- Telegram alerts (pnpm example notifier) ----
# Bot token from @BotFather. Then message your bot: /watch 0xYourOwnerAddress
TELEGRAM_BOT_TOKEN=
# Optional. Where the alert buttons link to (default: the live app).
# APP_URL=https://spendshield-psi.vercel.app

# Only for `pnpm example ai-agent` (the Messages API agent). `pnpm example claude-agent` uses your Claude Code login instead.
# ANTHROPIC_API_KEY=
